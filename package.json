{
  "name": "pi-clear-screen",
  "version": "0.2.0",
  "description": "Pi extension: /clear wipes the visible transcript only. Session file, session name, and model context are untouched — unlike every other /clear package, which maps to /new.",
  "license": "MIT",
  "author": "zliu250",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "clear",
    "cls",
    "transcript",
    "tui",
    "terminal"
  ],
  "homepage": "https://github.com/zliu250/pi-clear-screen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zliu250/pi-clear-screen.git"
  },
  "bugs": {
    "url": "https://github.com/zliu250/pi-clear-screen/issues"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typescript": "^5.9.3"
  }
}
