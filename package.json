{
  "name": "@zliu250/pi-extensions",
  "version": "0.3.0",
  "description": "A collection of pi extensions. /clear wipes the visible transcript only; /dump starts a new session and erases the old one from disk; /incognito auto-erases the session file when the session ends.",
  "license": "MIT",
  "author": "zliu250",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "clear",
    "cls",
    "transcript",
    "incognito",
    "session",
    "privacy",
    "tui",
    "terminal"
  ],
  "homepage": "https://github.com/zliu250/pi-extensions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zliu250/pi-extensions.git"
  },
  "bugs": {
    "url": "https://github.com/zliu250/pi-extensions/issues"
  },
  "pi": {
    "extensions": [
      "./extensions/clear-screen.ts",
      "./extensions/dump-session.ts"
    ]
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typescript": "^5.9.3"
  }
}
