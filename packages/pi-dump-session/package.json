    "privacy",
    "dump",
    "erase"
  ],
  "homepage": "https://github.com/zliu250/pi-extensions/tree/main/packages/pi-dump-session#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zliu250/pi-extensions.git",
    "directory": "packages/pi-dump-session"
  },
  "bugs": {
    "url": "https://github.com/zliu250/pi-extensions/issues"
  },
  "pi": {
